{
  "cleanUrls": true,
  "functions": {
    "api/upload.js": { "maxDuration": 60 },
    "api/notes.js": { "maxDuration": 60 },
    "api/modules.js": { "maxDuration": 60 },
    "api/module-file.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
